{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/morphic-bio/STAR-suite-provenance/schema/record-v1.schema.json",
  "title": "STAR Suite public provenance record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "record_id",
    "recorded_utc",
    "kind",
    "status",
    "software",
    "method",
    "evidence",
    "limitations"
  ],
  "properties": {
    "schema": {"const": "starsuite.provenance_record/v1"},
    "record_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]+$"},
    "recorded_utc": {"type": "string", "format": "date-time"},
    "kind": {"enum": ["benchmark", "parity", "hpc-validation", "release-validation", "correction"]},
    "status": {"enum": ["complete", "partial", "superseded"]},
    "supersedes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "software": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "revision"],
        "properties": {
          "repository": {"type": "string"},
          "revision": {"type": "string"},
          "version": {"type": "string"}
        }
      }
    },
    "environment": {"type": "object"},
    "method": {"type": "string", "minLength": 20},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["logical_uri"],
        "properties": {
          "logical_uri": {"type": "string", "pattern": "^(git|release|record)://"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
