            "description": "Open [Perturb Demo](command:starSuiteWalkthrough.openPerturbGuide) to see the current limits and swap plan.",
            "media": {
              "image": "media/prototype.svg",
              "altText": "Perturb placeholder"
            },
            "completionEvents": [
              "onCommand:starSuiteWalkthrough.openPerturbGuide"
            ]
          },
          {
            "id": "perturbDryRun",
