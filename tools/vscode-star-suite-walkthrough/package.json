              "altText": "SLAM terminal"
            },
            "completionEvents": [
              "onCommand:starSuiteWalkthrough.runSlamDryRun"
            ]
          }
        ]
      },
      {
        "id": "singleCellFixture",
        "title": "Utility: Single-cell Fixture",
        "description": "Shared bounded public GEX fixture derivation for perturb and Flex. This is not a required chapter for bulk or SLAM.",
        "featuredFor": [
          "workspace"
        ],
        "steps": [
          {
            "id": "fixtureGuide",
            "title": "Open the fixture guide",
            "description": "Open [Single-cell Fixture Derivation](command:starSuiteWalkthrough.openFixtureGuide) for the bounded derivation flow.",
            "media": {
              "image": "media/reference.svg",
              "altText": "Fixture guide"
            },
            "completionEvents": [
              "onCommand:starSuiteWalkthrough.openFixtureGuide"
            ]
          },
          {
            "id": "fixtureDryRun",
            "title": "Preview the fixture derivation",
            "description": "Launch the dry-run helper with [Preview Single-cell Fixture Derivation](command:starSuiteWalkthrough.runFixtureDryRun).",
            "media": {
              "image": "media/terminal.svg",
              "altText": "Fixture terminal"
            },
            "completionEvents": [
              "onCommand:starSuiteWalkthrough.runFixtureDryRun"
            ]
          }
        ]
      },
      {
        "id": "perturbPlaceholder",
        "title": "Perturb Demo (Prototype)",
        "description": "Independent perturb chapter placeholder until the real public assay fixture replaces the current scaffold.",
        "featuredFor": [
          "workspace"
        ],
        "steps": [
          {
            "id": "perturbGuide",
