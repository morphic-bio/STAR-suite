      },
      {
        "command": "starSuiteWalkthrough.runFixtureDryRun",
        "title": "STAR-suite: Preview Single-cell Fixture Derivation"
      },
      {
        "command": "starSuiteWalkthrough.runBulkDryRun",
        "title": "STAR-suite: Preview Bulk Demo Command"
      },
      {
        "command": "starSuiteWalkthrough.runSlamDryRun",
        "title": "STAR-suite: Preview SLAM Demo Command"
      },
      {
        "command": "starSuiteWalkthrough.runPerturbDryRun",
        "title": "STAR-suite: Preview Perturb Prototype Command"
      },
      {
        "command": "starSuiteWalkthrough.runFlexDryRun",
        "title": "STAR-suite: Preview Flex Prototype Command"
      },
      {
        "command": "starSuiteWalkthrough.openFoundationWalkthrough",
        "title": "STAR-suite: Open Foundation Walkthrough"
      },
      {
        "command": "starSuiteWalkthrough.openBulkWalkthrough",
        "title": "STAR-suite: Open Bulk Walkthrough"
      },
      {
        "command": "starSuiteWalkthrough.openSlamWalkthrough",
        "title": "STAR-suite: Open SLAM Walkthrough"
      },
      {
        "command": "starSuiteWalkthrough.openFixtureWalkthrough",
        "title": "STAR-suite: Open Single-cell Fixture Walkthrough"
      },
      {
        "command": "starSuiteWalkthrough.openPerturbWalkthrough",
        "title": "STAR-suite: Open Perturb Walkthrough"
      },
      {
        "command": "starSuiteWalkthrough.openFlexWalkthrough",
        "title": "STAR-suite: Open Flex Walkthrough"
      },
      {
        "command": "starSuiteWalkthrough.openStarCrGuide",
        "title": "STAR-suite: Open STAR / Cell Ranger Guidance"
      }
    ],
    "walkthroughs": [
      {
        "id": "overview",
        "title": "Overview",
        "description": "Choose an independent STAR-suite demo chapter. The foundation chapter is optional.",
        "featuredFor": [
          "workspace"
        ],
        "steps": [
          {
            "id": "overviewGuide",
            "title": "Open the Codespaces overview",
            "description": "Open [the overview guide](command:starSuiteWalkthrough.openOverviewGuide) to see the chapter model and current stable surfaces.",
            "media": {
              "image": "media/setup.svg",
              "altText": "Overview"
            },
            "completionEvents": [
              "onCommand:starSuiteWalkthrough.openOverviewGuide"
            ]
          },
          {
            "id": "experiencedStart",
            "title": "Experienced users: skip directly to a chapter",
            "description": "If you already know STAR and have a suitable index, jump straight to [Bulk](command:starSuiteWalkthrough.openBulkWalkthrough) or [SLAM](command:starSuiteWalkthrough.openSlamWalkthrough). Use [Single-cell Fixture](command:starSuiteWalkthrough.openFixtureWalkthrough) only for perturb or Flex.",
            "media": {
              "image": "media/terminal.svg",
              "altText": "Experienced user path"
            },
            "completionEvents": [
              "onCommand:starSuiteWalkthrough.openBulkWalkthrough",
              "onCommand:starSuiteWalkthrough.openSlamWalkthrough",
              "onCommand:starSuiteWalkthrough.openFixtureWalkthrough"
            ]
          },
          {
            "id": "starCrStart",
            "title": "STAR / Cell Ranger users: focus on deltas",
            "description": "Open [STAR / Cell Ranger guidance](command:starSuiteWalkthrough.openStarCrGuide) if you want the walkthrough to highlight what changes relative to normal STAR or Cell Ranger usage.",
            "media": {
              "image": "media/reference.svg",
              "altText": "STAR and Cell Ranger guidance"
            },
            "completionEvents": [
              "onCommand:starSuiteWalkthrough.openStarCrGuide"
            ]
          },
          {
            "id": "noviceStart",
            "title": "Novice users: start with the foundation or bulk",
            "description": "If you want the gentlest path, open [Optional: Build Mini Reference](command:starSuiteWalkthrough.openFoundationWalkthrough) first and then move to [Bulk](command:starSuiteWalkthrough.openBulkWalkthrough).",
            "media": {
              "image": "media/setup.svg",
              "altText": "Novice user path"
            },
            "completionEvents": [
              "onCommand:starSuiteWalkthrough.openFoundationWalkthrough",
              "onCommand:starSuiteWalkthrough.openBulkWalkthrough"
            ]
          },
          {
            "id": "foundation",
            "title": "Optional foundation chapter",
            "description": "If you need the shared mini-reference, jump to [Optional: Build Mini Reference](command:starSuiteWalkthrough.openFoundationWalkthrough). Otherwise skip it.",
            "media": {
              "image": "media/reference.svg",
              "altText": "Foundation"
            },
            "completionEvents": [
              "onCommand:starSuiteWalkthrough.openFoundationWalkthrough"
            ]
          },
          {
            "id": "bulk",
            "title": "Bulk chapter",
            "description": "Open the independent [Bulk walkthrough](command:starSuiteWalkthrough.openBulkWalkthrough).",
            "media": {
              "image": "media/bulk.svg",
              "altText": "Bulk"
            },
            "completionEvents": [
              "onCommand:starSuiteWalkthrough.openBulkWalkthrough"
            ]
          },
          {
            "id": "slam",
            "title": "SLAM chapter",
            "description": "Open the independent [SLAM walkthrough](command:starSuiteWalkthrough.openSlamWalkthrough).",
            "media": {
              "image": "media/slam.svg",
              "altText": "SLAM"
            },
            "completionEvents": [
              "onCommand:starSuiteWalkthrough.openSlamWalkthrough"
            ]
          },
          {
            "id": "fixture",
            "title": "Single-cell fixture utility",
            "description": "Open the shared [Single-cell Fixture walkthrough](command:starSuiteWalkthrough.openFixtureWalkthrough) if you want the bounded public GEX input used by perturb and Flex.",
            "media": {
              "image": "media/reference.svg",
              "altText": "Fixture"
            },
            "completionEvents": [
              "onCommand:starSuiteWalkthrough.openFixtureWalkthrough"
            ]
          },
          {
            "id": "perturb",
            "title": "Perturb prototype chapter",
            "description": "Open the current [Perturb walkthrough](command:starSuiteWalkthrough.openPerturbWalkthrough).",
            "media": {
              "image": "media/prototype.svg",
              "altText": "Perturb"
            },
            "completionEvents": [
              "onCommand:starSuiteWalkthrough.openPerturbWalkthrough"
            ]
          },
          {
            "id": "flex",
            "title": "Flex prototype chapter",
            "description": "Open the current [Flex walkthrough](command:starSuiteWalkthrough.openFlexWalkthrough).",
            "media": {
              "image": "media/prototype.svg",
              "altText": "Flex"
            },
            "completionEvents": [
              "onCommand:starSuiteWalkthrough.openFlexWalkthrough"
            ]
          }
        ]
      },
      {
        "id": "foundation",
        "title": "Optional: Build Mini Reference",
        "description": "Build the shared public chr22 + chrY mini-reference only if you need the demo source surface or do not already have a suitable index.",
        "featuredFor": [
          "workspace"
        ],
        "steps": [
          {
            "id": "setupGuide",
            "title": "Open the foundation guide",
            "description": "Open [Setup + Mini Reference](command:starSuiteWalkthrough.openSetupGuide) for the exact reference contract and outputs.",
            "media": {
              "image": "media/reference.svg",
              "altText": "Reference guide"
            },
            "completionEvents": [
              "onCommand:starSuiteWalkthrough.openSetupGuide"
            ]
          },
          {
            "id": "fetchReference",
            "title": "Fetch chr22 + chrY reference sources",
            "description": "Launch the real reference fetch in an integrated terminal with [Run chr22+chrY Reference Fetch](command:starSuiteWalkthrough.runFetchReference).",
            "media": {
              "image": "media/reference.svg",
              "altText": "Fetch reference"
            },
            "completionEvents": [
              "onCommand:starSuiteWalkthrough.runFetchReference"
            ]
          },
          {
            "id": "buildIndex",
            "title": "Build the demo STAR index",
            "description": "Build the shared mini-reference index with [Build chr22+chrY Demo Index](command:starSuiteWalkthrough.runBuildIndex).",
            "media": {
              "image": "media/terminal.svg",
              "altText": "Build index"
            },
            "completionEvents": [
              "onCommand:starSuiteWalkthrough.runBuildIndex"
            ]
          }
        ]
      },
      {
