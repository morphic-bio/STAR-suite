{
  "name": "star-suite-walkthrough",
  "displayName": "STAR-suite Demo Walkthrough",
  "description": "Guided Codespaces walkthroughs for the stable STAR-suite demo surfaces.",
  "version": "0.0.1",
  "publisher": "morphic-bio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/morphic-bio/STAR-suite.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:starSuiteWalkthrough.openBulkGuide",
    "onCommand:starSuiteWalkthrough.openBulkWalkthrough",
    "onCommand:starSuiteWalkthrough.openFixtureGuide",
    "onCommand:starSuiteWalkthrough.openFixtureWalkthrough",
    "onCommand:starSuiteWalkthrough.openFlexGuide",
    "onCommand:starSuiteWalkthrough.openFlexWalkthrough",
    "onCommand:starSuiteWalkthrough.openFoundationWalkthrough",
    "onCommand:starSuiteWalkthrough.openMainWalkthrough",
    "onCommand:starSuiteWalkthrough.openOverviewGuide",
    "onCommand:starSuiteWalkthrough.openPerturbGuide",
    "onCommand:starSuiteWalkthrough.openPerturbWalkthrough",
    "onCommand:starSuiteWalkthrough.openSetupGuide",
    "onCommand:starSuiteWalkthrough.openSlamGuide",
    "onCommand:starSuiteWalkthrough.openSlamWalkthrough",
    "onCommand:starSuiteWalkthrough.openStarCrGuide",
    "onCommand:starSuiteWalkthrough.runBuildIndex",
    "onCommand:starSuiteWalkthrough.runBulkDryRun",
    "onCommand:starSuiteWalkthrough.runFetchReference",
    "onCommand:starSuiteWalkthrough.runFixtureDryRun",
    "onCommand:starSuiteWalkthrough.runFlexDryRun",
    "onCommand:starSuiteWalkthrough.runPerturbDryRun",
    "onCommand:starSuiteWalkthrough.runSlamDryRun"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "starSuiteWalkthrough.openMainWalkthrough",
        "title": "STAR-suite: Open Codespaces Walkthrough"
      },
      {
        "command": "starSuiteWalkthrough.openOverviewGuide",
        "title": "STAR-suite: Open Codespaces Demo Overview"
      },
      {
        "command": "starSuiteWalkthrough.openSetupGuide",
        "title": "STAR-suite: Open Setup + Mini Reference Guide"
      },
      {
        "command": "starSuiteWalkthrough.openBulkGuide",
        "title": "STAR-suite: Open Bulk Demo Guide"
      },
      {
        "command": "starSuiteWalkthrough.openSlamGuide",
        "title": "STAR-suite: Open SLAM Demo Guide"
      },
      {
        "command": "starSuiteWalkthrough.openFixtureGuide",
