        "title": "Bulk Demo",
        "description": "Independent public bulk walkthrough.",
        "featuredFor": [
          "workspace"
        ],
        "steps": [
          {
            "id": "bulkGuide",
            "title": "Open the bulk guide",
            "description": "Open [Bulk Demo](command:starSuiteWalkthrough.openBulkGuide) for the command shape and outputs.",
            "media": {
              "image": "media/bulk.svg",
              "altText": "Bulk guide"
            },
            "completionEvents": [
              "onCommand:starSuiteWalkthrough.openBulkGuide"
