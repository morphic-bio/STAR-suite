ARG BASE_IMAGE=ubuntu:24.04
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Etc/UTC

COPY scripts/release/docker/container_check_tarball.sh /usr/local/bin/container_check_tarball.sh
COPY scripts/release/docker/container_check_installer_bundle.sh /usr/local/bin/container_check_installer_bundle.sh
COPY scripts/release/docker/container_check_release_smokes.sh /usr/local/bin/container_check_release_smokes.sh

RUN apt-get update && apt-get install -y --no-install-recommends \
    tzdata \
    ca-certificates \
    curl \
    git \
    git-lfs \
    python3 \
    python3-pandas \
    samtools \
    salmon \
    && rm -rf /var/lib/apt/lists/* \
    && chmod 0755 /usr/local/bin/container_check_tarball.sh /usr/local/bin/container_check_installer_bundle.sh /usr/local/bin/container_check_release_smokes.sh

WORKDIR /work
ENTRYPOINT ["/bin/bash"]
